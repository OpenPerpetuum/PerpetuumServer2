<Window x:Class="Perpetuum.AdminTool.Views.AddTemplateRelationRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add robot-template relation"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Links an entitydefaults row (a robot type) to a robot template (loadout). PK is `definition`, so each robot type can have only one relation."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Definition (entitydefaults):" Margin="0,4" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                  ItemsSource="{Binding Lookups.Entities}"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Definition"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  TextSearch.TextPath="Display"
                  SelectedValue="{Binding Definition, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Template:" Margin="0,4" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                  ItemsSource="{Binding Lookups.Templates}"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Id"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  TextSearch.TextPath="Display"
                  SelectedValue="{Binding TemplateId, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Race id:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="3" Grid.Column="1" Margin="0,4"
                  Text="{Binding RaceId, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Item score sum:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="4" Grid.Column="1" Margin="0,4"
                  Text="{Binding ItemScoreSum, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Mission level (nullable):" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="5" Grid.Column="1" Margin="0,4"
                  Text="{Binding MissionLevel, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Mission level override:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="6" Grid.Column="1" Margin="0,4"
                  Text="{Binding MissionLevelOverride, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Kill EP (nullable):" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="7" Grid.Column="1" Margin="0,4"
                  Text="{Binding KillEp, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Note:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="8" Grid.Column="1" Margin="0,4" MaxLength="256"
                  Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Foreground="DarkRed" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"/>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnAddClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
