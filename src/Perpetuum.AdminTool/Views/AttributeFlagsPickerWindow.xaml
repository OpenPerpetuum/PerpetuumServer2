<Window x:Class="Perpetuum.AdminTool.Views.AttributeFlagsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit attribute flag bits"
        Width="420" Height="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,2"
                                  IsChecked="{Binding IsChecked}"
                                  Content="{Binding Display}"
                                  FontFamily="Consolas"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
