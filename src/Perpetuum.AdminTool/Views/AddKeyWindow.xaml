<Window x:Class="Perpetuum.AdminTool.Views.AddKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add translation key"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock Text="Translation key (e.g. def_npc_my_npc_rank1):" Margin="0,0,0,4"/>
        <TextBox x:Name="KeyBox" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Margin="0,8,0,0"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Add" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnAddClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
