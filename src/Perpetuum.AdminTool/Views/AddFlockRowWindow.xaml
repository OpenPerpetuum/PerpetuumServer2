<Window x:Class="Perpetuum.AdminTool.Views.AddFlockRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add NPC flock"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="A new flock. PK is `id` (IDENTITY). Presence + definition must already exist."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="1" Grid.Column="1" Margin="0,4"
                  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Presence:" Margin="0,4" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="2" Grid.Column="1" Margin="0,4"
                   ItemsSource="{Binding PresencePicks}"
                   DisplayMemberPath="Display"
                   SelectedValuePath="Id"
                   IsEditable="True"
                   IsTextSearchEnabled="True"
                   TextSearch.TextPath="Display"
                   SelectedValue="{Binding PresenceId, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Definition (NPC):" Margin="0,4" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="3" Grid.Column="1" Margin="0,4"
                   ItemsSource="{Binding Lookups.Entities}"
                   DisplayMemberPath="Display"
                   SelectedValuePath="Definition"
                   IsEditable="True"
                   IsTextSearchEnabled="True"
                   TextSearch.TextPath="Display"
                   SelectedValue="{Binding Definition, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Member count:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="4" Grid.Column="1" Margin="0,4"
                  Text="{Binding FlockMemberCount, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Spawn origin X:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="5" Grid.Column="1" Margin="0,4"
                  Text="{Binding SpawnOriginX, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Spawn origin Y:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="6" Grid.Column="1" Margin="0,4"
                  Text="{Binding SpawnOriginY, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Spawn range min:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="7" Grid.Column="1" Margin="0,4"
                  Text="{Binding SpawnRangeMin, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Spawn range max:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="8" Grid.Column="1" Margin="0,4"
                  Text="{Binding SpawnRangeMax, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Respawn seconds:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="9" Grid.Column="1" Margin="0,4"
                  Text="{Binding RespawnSeconds, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Total spawn count:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="10" Grid.Column="1" Margin="0,4"
                  Text="{Binding TotalSpawnCount, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Home range:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="11" Grid.Column="1" Margin="0,4"
                  Text="{Binding HomeRange, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Respawn multiplier low:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="12" Grid.Column="1" Margin="0,4"
                  Text="{Binding RespawnMultiplierLow, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="13" Grid.Column="0" Text="Behavior type:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="13" Grid.Column="1" Margin="0,4"
                  Text="{Binding BehaviorType, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="14" Grid.Column="0" Text="NPC special type:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="14" Grid.Column="1" Margin="0,4"
                  Text="{Binding NpcSpecialType, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="15" Grid.Column="0" Text="Note:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="15" Grid.Column="1" Margin="0,4"
                  Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <CheckBox Grid.Row="16" Grid.Column="1" Margin="0,4" Content="Enabled"
                  IsChecked="{Binding Enabled}"/>
        <CheckBox Grid.Row="17" Grid.Column="1" Margin="0,4" Content="Call for help"
                  IsChecked="{Binding IsCallForHelp}"/>

        <TextBlock Grid.Row="18" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Foreground="DarkRed" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"/>

        <StackPanel Grid.Row="19" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnAddClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
