<UserControl x:Class="Perpetuum.AdminTool.Views.PresencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Perpetuum.AdminTool.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <common:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F8F8F8" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="Reload" Padding="10,2" Margin="0,0,8,0" Click="OnReloadClick"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:InverseBoolConverter.Instance}}"/>
                <Button Content="Save changes" Padding="14,2" Margin="0,0,8,0" FontWeight="Bold" Click="OnSaveClick"/>
                <Separator Margin="6,0"/>
                <Button Content="Add presence..." Padding="10,2" Margin="0,0,8,0" Click="OnAddClick"/>
                <Button Content="Remove selected" Padding="10,2" Margin="0,0,8,0" Foreground="DarkRed" Click="OnRemoveClick"/>
                <Separator Margin="6,0"/>
                <Button Content="Show flocks..." Padding="10,2" Margin="0,0,8,0" Click="OnShowFlocksClick"/>
                <Separator Margin="6,0"/>
                <TextBlock Text="Filter (id / name / spawn):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="200" VerticalAlignment="Center"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="DimGray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="DarkRed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding View}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" IsReadOnly="True"
                                    Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="200"/>

                <DataGridTextColumn Header="Spawn id"
                                    Binding="{Binding SpawnId, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"/>
                <DataGridTemplateColumn Header="Spawn name" Width="200" SortMemberPath="SpawnName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4,0" VerticalAlignment="Center"
                                       Text="{Binding SpawnName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Source={StaticResource VmProxy}, Path=Data.ZoneSpawnPicks}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="SpawnId"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Display"
                                      SelectedValue="{Binding SpawnId, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Top X"
                                    Binding="{Binding TopX, UpdateSourceTrigger=LostFocus}" Width="70"/>
                <DataGridTextColumn Header="Top Y"
                                    Binding="{Binding TopY, UpdateSourceTrigger=LostFocus}" Width="70"/>
                <DataGridTextColumn Header="Bottom X"
                                    Binding="{Binding BottomX, UpdateSourceTrigger=LostFocus}" Width="80"/>
                <DataGridTextColumn Header="Bottom Y"
                                    Binding="{Binding BottomY, UpdateSourceTrigger=LostFocus}" Width="80"/>
                <DataGridCheckBoxColumn Header="Enabled"
                                        Binding="{Binding Enabled, UpdateSourceTrigger=LostFocus}" Width="70"/>
                <DataGridCheckBoxColumn Header="Roaming"
                                        Binding="{Binding Roaming, UpdateSourceTrigger=LostFocus}" Width="70"/>
                <DataGridTextColumn Header="Roam respawn s"
                                    Binding="{Binding RoamingRespawnSeconds, UpdateSourceTrigger=LostFocus}" Width="110"/>
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding PresenceType, UpdateSourceTrigger=LostFocus}" Width="60"/>
                <DataGridTextColumn Header="Max rand flock"
                                    Binding="{Binding MaxRandomFlock, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="100"/>
                <DataGridTextColumn Header="Rand cx"
                                    Binding="{Binding RandomCenterX, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"/>
                <DataGridTextColumn Header="Rand cy"
                                    Binding="{Binding RandomCenterY, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"/>
                <DataGridTextColumn Header="Rand radius"
                                    Binding="{Binding RandomRadius, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="90"/>
                <DataGridTextColumn Header="Dyn lifetime"
                                    Binding="{Binding DynamicLifetime, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="90"/>
                <DataGridCheckBoxColumn Header="Body pull"
                                        Binding="{Binding IsBodyPull, UpdateSourceTrigger=LostFocus}" Width="80"/>
                <DataGridCheckBoxColumn Header="Respawn ok"
                                        Binding="{Binding IsRespawnAllowed, UpdateSourceTrigger=LostFocus}" Width="90"/>
                <DataGridCheckBoxColumn Header="Safe pull"
                                        Binding="{Binding SafeBodyPull, UpdateSourceTrigger=LostFocus}" Width="80"/>
                <DataGridTextColumn Header="IZ group"
                                    Binding="{Binding IzGroupId, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"/>
                <DataGridTextColumn Header="Growth s"
                                    Binding="{Binding GrowthSeconds, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"/>
                <DataGridTextColumn Header="Note"
                                    Binding="{Binding Note, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
