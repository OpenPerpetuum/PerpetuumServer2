<Window x:Class="Perpetuum.AdminTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:Perpetuum.AdminTool.Settings"
        xmlns:views="clr-namespace:Perpetuum.AdminTool.Views"
        Title="Perpetuum Admin Tool"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ObjectDataProvider x:Key="ApplyModes" MethodName="GetValues" ObjectType="{x:Type settings:ApplyMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="settings:ApplyMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Connection settings..." Click="OnOpenSettingsClick"/>
                <Separator/>
                <MenuItem Header="Sign out" Click="OnLogoutClick"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Apply mode:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="140" VerticalAlignment="Center"
                          ItemsSource="{Binding Source={StaticResource ApplyModes}}"
                          SelectedItem="{Binding CurrentMode}"/>
                <Separator Margin="12,0"/>
                <Button Content="Add stub change" Padding="8,2" Margin="0,0,8,0"
                        Command="{Binding AddStubChangeCommand}"/>
                <Button Content="Clear pending" Padding="8,2" Margin="0,0,8,0"
                        Command="{Binding ClearChangesCommand}"/>
                <Button Content="Commit" Padding="14,2" FontWeight="Bold" Click="OnCommitClick"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="ModuleTabs" Margin="0">
            <TabItem Header="Entities">
                <views:EntitiesView DataContext="{Binding Entities}"/>
            </TabItem>
            <TabItem Header="Robot templates">
                <views:RobotTemplatesView DataContext="{Binding RobotTemplates}"/>
            </TabItem>
            <TabItem Header="Template relations">
                <views:RobotTemplateRelationsView DataContext="{Binding RobotTemplateRelations}"/>
            </TabItem>
            <TabItem Header="NPC loot">
                <views:NpcLootView DataContext="{Binding NpcLoot}"/>
            </TabItem>
            <TabItem Header="NPC presences">
                <views:PresencesView DataContext="{Binding Presences}"/>
            </TabItem>
            <TabItem Header="NPC flocks">
                <views:FlocksView DataContext="{Binding Flocks}"/>
            </TabItem>
            <TabItem Header="Seasons">
                <views:SeasonsView DataContext="{Binding Seasons}"/>
            </TabItem>
            <TabItem Header="Equipment Sets">
                <views:EquipmentSetsView DataContext="{Binding EquipmentSets}"/>
            </TabItem>
            <TabItem Header="AutoMarket">
                <views:AutoMarketView DataContext="{Binding AutoMarket}"/>
            </TabItem>
            <TabItem Header="Translations">
                <views:TranslationsView DataContext="{Binding Translations}"/>
            </TabItem>
            <TabItem Header="Pending changes">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="8" Foreground="DimGray"
                               TextWrapping="Wrap"
                               Text="Pending DB changes from later phases will accumulate here. Translations save directly to JSON files and are not queued."/>
                    <DataGrid ItemsSource="{Binding Changes.Items}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
