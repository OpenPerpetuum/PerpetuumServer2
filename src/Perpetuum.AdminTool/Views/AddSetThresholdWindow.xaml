<Window x:Class="Perpetuum.AdminTool.Views.AddSetThresholdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add bonus threshold"
        Width="580" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">

        <!-- Bottom: inputs + buttons -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Required pieces:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox   Grid.Column="1" Text="{Binding RequiredPieces, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="3" Text="Bonus value:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox   Grid.Column="4" Text="{Binding BonusValue, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Add" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnAddClick"/>
                    <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="DarkRed" Text="{Binding ErrorMessage}"/>
            </DockPanel>
        </StackPanel>

        <!-- Search box -->
        <TextBox DockPanel.Dock="Top"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                 Margin="0,0,0,6"/>

        <!-- Field list -->
        <DataGrid ItemsSource="{Binding View}"
                  SelectedItem="{Binding SelectedField}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"           Binding="{Binding Id}"            Width="50"/>
                <DataGridTextColumn Header="System name"  Binding="{Binding Name}"          Width="220"/>
                <DataGridTextColumn Header="Display name" Binding="{Binding TranslatedName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
