<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perpetuum.AdminTool.Avalonia.ViewModels"
             xmlns:templates="using:Perpetuum.AdminTool.Templates"
             x:Class="Perpetuum.AdminTool.Avalonia.Views.RobotTemplateRelationsCatalogView"
             x:DataType="vm:RobotTemplateRelationsCatalogViewModel">
  <Border Padding="16" BorderBrush="#808080" BorderThickness="1" CornerRadius="6">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,280,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Robot-template relations" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Map robot entity definitions to templates through reviewed SQL changes."
                     Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox Grid.Column="1" Watermark="definition, template id, or name"
                 Text="{Binding FilterText}" />
        <Button Grid.Column="2" Content="Reload" Command="{Binding LoadCommand}"
                IsEnabled="{Binding IsNotLoading}" />
      </Grid>

      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Watermark="new robot definition" Text="{Binding NewDefinition}" />
        <TextBox Grid.Column="1" Watermark="template id" Text="{Binding NewTemplateId}" />
        <Button Grid.Column="2" Content="Create unsaved relation"
                Command="{Binding CreateRelationCommand}" />
      </Grid>

      <Grid ColumnDefinitions="400,*" ColumnSpacing="16">
        <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 MinHeight="340" MaxHeight="540">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="templates:RobotTemplateRelationRow">
              <Grid ColumnDefinitions="70,*,70,*" ColumnSpacing="6" Margin="2">
                <TextBlock Grid.Column="0" Text="{Binding Definition}" Opacity="0.65" />
                <TextBlock Grid.Column="1" Text="{Binding DefinitionName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding TemplateId}" Opacity="0.65" />
                <TextBlock Grid.Column="3" Text="{Binding TemplateName}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Column="1" ColumnDefinitions="150,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="10" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Definition" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRow.Definition}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Definition name" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRow.DefinitionName}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Template id" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.TemplateId}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Template name" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRow.TemplateName}" />
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Race id" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRow.RaceId}" />
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Item score sum" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRow.ItemScoreSum}" />
          <TextBlock Grid.Row="6" Grid.Column="0" Text="Mission / override" />
          <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding SelectedRow.MissionLevel}" />
            <TextBox Grid.Column="1" Text="{Binding SelectedRow.MissionLevelOverride}" />
          </Grid>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="Kill EP" />
          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedRow.KillEp}" />
          <TextBlock Grid.Row="8" Grid.Column="0" Text="Note" />
          <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedRow.Note}" />
        </Grid>
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Content="Queue DELETE" Command="{Binding QueueDeleteCommand}" />
        <Button Grid.Column="2" Content="Revert edits" Command="{Binding RevertSelectedChangesCommand}" />
        <Button Grid.Column="3" Content="Queue changes" Command="{Binding QueueSelectedChangesCommand}" />
      </Grid>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
