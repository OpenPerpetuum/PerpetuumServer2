<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perpetuum.AdminTool.Avalonia.ViewModels"
             xmlns:translations="using:Perpetuum.AdminTool.Translations"
             x:Class="Perpetuum.AdminTool.Avalonia.Views.TranslationCatalogView"
             x:DataType="vm:TranslationCatalogViewModel">
  <Border Padding="16" BorderBrush="#808080" BorderThickness="1" CornerRadius="6">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,280,Auto,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Translations" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Edit customDictionary JSON files directly. These changes do not use the SQL pending-change queue."
                     Opacity="0.7" TextWrapping="Wrap" />
          <TextBlock Text="{Binding GameRootPath}" FontSize="11" Opacity="0.65" />
        </StackPanel>
        <TextBox Grid.Column="1" Watermark="filter key or translated text" Text="{Binding FilterText}" />
        <Button Grid.Column="2" Content="Reload" Command="{Binding LoadCommand}"
                IsEnabled="{Binding IsNotLoading}" />
        <Button Grid.Column="3" Content="Save dictionary files" Command="{Binding SaveCommand}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto,240,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Watermark="new translation key" Text="{Binding NewKey}" />
        <Button Grid.Column="1" Content="Add unsaved key" Command="{Binding AddKeyCommand}" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedNewLanguage}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="translations:LanguageInfo">
              <TextBlock>
                <Run Text="{Binding Id}"/><Run Text=" — "/><Run Text="{Binding Name}"/>
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="3" Content="Add language" Command="{Binding AddLanguageCommand}" />
      </Grid>

      <Grid ColumnDefinitions="360,*" ColumnSpacing="16">
        <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 MinHeight="430" MaxHeight="680">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="translations:TranslationRow">
              <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" Margin="2" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Text="Translation key" FontWeight="SemiBold" />
          <TextBox Text="{Binding SelectedRow.Key}" />
          <TextBlock Text="Language values" FontWeight="SemiBold" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{Binding Values}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TranslationValueEditorViewModel">
                <Grid ColumnDefinitions="150,*" ColumnSpacing="8" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Remove selected key from every language"
                  Command="{Binding RemoveSelectedKeyCommand}"
                  HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
