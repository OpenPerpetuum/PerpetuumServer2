<Window x:Class="Perpetuum.AdminTool.Views.RobotTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Perpetuum.AdminTool.ViewModels;assembly=Perpetuum.AdminTool.Core"
        Title="Robot template — structured editor"
        Width="900" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:RobotTemplateSlotViewModel}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SlotIndex}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1" Text="{Binding SlotFlagHex}" VerticalAlignment="Center"
                           Foreground="DimGray" FontFamily="Consolas" FontSize="11"
                           ToolTip="The slot's flag mask. A module fits if its moduleFlag has only bits that are set in this mask."/>
                <ComboBox Grid.Column="2" Margin="0,0,4,0"
                          ItemsSource="{Binding ModulePicks}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Definition"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Display"
                          SelectedValue="{Binding ModuleDefinition, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Column="3" Margin="0,0,4,0"
                          IsEnabled="{Binding IsAmmoable}"
                          ItemsSource="{Binding AmmoPicks}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Definition"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Display"
                          SelectedValue="{Binding AmmoDefinition, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="4"
                         IsEnabled="{Binding IsAmmoable}"
                         Text="{Binding AmmoQuantity, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="14">
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="OK" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
                    <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
                </StackPanel>
                <TextBlock Foreground="DarkRed" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{Binding ErrorMessage}"/>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DimGray"
                   Text="Pick robot, head, chassis, leg and container; the editor reads slotFlags from each part's options to build slot rows. Module dropdowns are filtered by the slot's flag, ammo by the chosen module's ammoCategoryFlags. Empty slots are dropped on save. Cargo `items` (if present) round-trips untouched."/>

        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="8" Background="#F8F8F8" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Robot:" Margin="0,2" VerticalAlignment="Center"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,2"
                           ItemsSource="{Binding RobotPicks}"
                           DisplayMemberPath="Display"
                           SelectedValuePath="Definition"
                           IsEditable="True"
                           IsTextSearchEnabled="True"
                           TextSearch.TextPath="Display"
                           SelectedValue="{Binding RobotDefinition, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Head:" Margin="0,2" VerticalAlignment="Center"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" Margin="0,2"
                           ItemsSource="{Binding HeadPicks}"
                           DisplayMemberPath="Display"
                           SelectedValuePath="Definition"
                           IsEditable="True"
                           IsTextSearchEnabled="True"
                           TextSearch.TextPath="Display"
                           SelectedValue="{Binding HeadDefinition, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Chassis:" Margin="0,2" VerticalAlignment="Center"/>
                <ComboBox  Grid.Row="2" Grid.Column="1" Margin="0,2"
                           ItemsSource="{Binding ChassisPicks}"
                           DisplayMemberPath="Display"
                           SelectedValuePath="Definition"
                           IsEditable="True"
                           IsTextSearchEnabled="True"
                           TextSearch.TextPath="Display"
                           SelectedValue="{Binding ChassisDefinition, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Leg:" Margin="0,2" VerticalAlignment="Center"/>
                <ComboBox  Grid.Row="3" Grid.Column="1" Margin="0,2"
                           ItemsSource="{Binding LegPicks}"
                           DisplayMemberPath="Display"
                           SelectedValuePath="Definition"
                           IsEditable="True"
                           IsTextSearchEnabled="True"
                           TextSearch.TextPath="Display"
                           SelectedValue="{Binding LegDefinition, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Container:" Margin="0,2" VerticalAlignment="Center"/>
                <ComboBox  Grid.Row="4" Grid.Column="1" Margin="0,2"
                           ItemsSource="{Binding ContainerPicks}"
                           DisplayMemberPath="Display"
                           SelectedValuePath="Definition"
                           IsEditable="True"
                           IsTextSearchEnabled="True"
                           TextSearch.TextPath="Display"
                           SelectedValue="{Binding ContainerDefinition, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Head modules" FontWeight="Bold" Margin="0,4"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Slot" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Slot flag" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Module" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Ammo" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="Ammo qty" FontWeight="Bold"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding HeadSlots}"/>

                <TextBlock Text="Chassis modules" FontWeight="Bold" Margin="0,12,0,4"/>
                <ItemsControl ItemsSource="{Binding ChassisSlots}"/>

                <TextBlock Text="Leg modules" FontWeight="Bold" Margin="0,12,0,4"/>
                <ItemsControl ItemsSource="{Binding LegSlots}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
