<Window x:Class="Perpetuum.AdminTool.Views.CategoryFlagsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick category"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Filter by name or hex:" Margin="0,0,0,4"/>
        <TextBox  DockPanel.Dock="Top" x:Name="FilterBox"
                  Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,8"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding View}"
                 SelectedItem="{Binding Selected}"
                 MouseDoubleClick="OnDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" Width="280"/>
                        <TextBlock Text="{Binding Hex}"  FontFamily="Consolas" Foreground="DimGray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
