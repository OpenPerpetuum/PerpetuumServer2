<Window x:Class="Perpetuum.AdminTool.Views.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Perpetuum.AdminTool.Common"
        Title="Connection Settings"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="SQL Server:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Integrated Security:" Margin="0,4" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,4" IsChecked="{Binding IntegratedSecurity}" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="SQL User:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="3" Grid.Column="1" Margin="0,4"
                  IsEnabled="{Binding IntegratedSecurity, Converter={x:Static common:InverseBoolConverter.Instance}}"
                  Text="{Binding SqlUser, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="SQL Password:" Margin="0,4" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PwdBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                     IsEnabled="{Binding IntegratedSecurity, Converter={x:Static common:InverseBoolConverter.Instance}}"
                     PasswordChanged="PwdBox_PasswordChanged"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Trust Server Cert:" Margin="0,4" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,4" IsChecked="{Binding TrustServerCertificate}" VerticalAlignment="Center"/>

        <Separator Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="GameRoot path:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="7" Grid.Column="1" Margin="0,4" Text="{Binding GameRootPath, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="SQL output dir:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="8" Grid.Column="1" Margin="0,4" Text="{Binding SqlOutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="9" Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   Text="{Binding TestStatus}"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="DarkGreen"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TestIsError}" Value="True">
                            <Setter Property="Foreground" Value="DarkRed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Test connection" Padding="10,4" Margin="0,0,8,0" Click="OnTestClick"/>
            <Button Content="Save" Padding="10,4" Margin="0,0,8,0" IsDefault="True" Click="OnSaveClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
