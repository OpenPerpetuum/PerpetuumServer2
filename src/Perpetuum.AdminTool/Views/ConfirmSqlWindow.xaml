<Window x:Class="Perpetuum.AdminTool.Views.ConfirmSqlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm direct database changes"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Header}"
                   FontWeight="Bold" Margin="0,0,0,8"
                   TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Text="The SQL below will be executed against the live database. Review carefully."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Apply to database" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnConfirmClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
        <TextBox Text="{Binding Sql, Mode=OneWay}"
                 IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True"/>
    </DockPanel>
</Window>
