<Window x:Class="Perpetuum.AdminTool.Views.AddPresenceRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add NPC presence"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="A new NPC presence. PK is `id` (IDENTITY). Name has a UNIQUE constraint."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="1" Grid.Column="1" Margin="0,4"
                  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Spawn (zone):" Margin="0,4" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="2" Grid.Column="1" Margin="0,4"
                   ItemsSource="{Binding ZoneSpawnPicks}"
                   DisplayMemberPath="Display"
                   SelectedValuePath="SpawnId"
                   IsEditable="True"
                   IsTextSearchEnabled="True"
                   TextSearch.TextPath="Display"
                   SelectedValue="{Binding SpawnId, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Top X:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="3" Grid.Column="1" Margin="0,4"
                  Text="{Binding TopX, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Top Y:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="4" Grid.Column="1" Margin="0,4"
                  Text="{Binding TopY, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Bottom X:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="5" Grid.Column="1" Margin="0,4"
                  Text="{Binding BottomX, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Bottom Y:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="6" Grid.Column="1" Margin="0,4"
                  Text="{Binding BottomY, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Roaming respawn s:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="7" Grid.Column="1" Margin="0,4"
                  Text="{Binding RoamingRespawnSeconds, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Presence type:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="8" Grid.Column="1" Margin="0,4"
                  Text="{Binding PresenceType, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Max random flock:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="9" Grid.Column="1" Margin="0,4"
                  Text="{Binding MaxRandomFlock, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Random center X:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="10" Grid.Column="1" Margin="0,4"
                  Text="{Binding RandomCenterX, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Random center Y:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="11" Grid.Column="1" Margin="0,4"
                  Text="{Binding RandomCenterY, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Random radius:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="12" Grid.Column="1" Margin="0,4"
                  Text="{Binding RandomRadius, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="13" Grid.Column="0" Text="Dynamic lifetime:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="13" Grid.Column="1" Margin="0,4"
                  Text="{Binding DynamicLifetime, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="14" Grid.Column="0" Text="IZ group id:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="14" Grid.Column="1" Margin="0,4"
                  Text="{Binding IzGroupId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="15" Grid.Column="0" Text="Growth seconds:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="15" Grid.Column="1" Margin="0,4"
                  Text="{Binding GrowthSeconds, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <TextBlock Grid.Row="16" Grid.Column="0" Text="Note:" Margin="0,4" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="16" Grid.Column="1" Margin="0,4"
                  Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

        <CheckBox Grid.Row="17" Grid.Column="1" Margin="0,4" Content="Enabled"
                  IsChecked="{Binding Enabled}"/>
        <CheckBox Grid.Row="18" Grid.Column="1" Margin="0,4" Content="Roaming"
                  IsChecked="{Binding Roaming}"/>
        <CheckBox Grid.Row="19" Grid.Column="1" Margin="0,4" Content="Body pull"
                  IsChecked="{Binding IsBodyPull}"/>
        <CheckBox Grid.Row="20" Grid.Column="1" Margin="0,4" Content="Respawn allowed"
                  IsChecked="{Binding IsRespawnAllowed}"/>
        <CheckBox Grid.Row="21" Grid.Column="1" Margin="0,4" Content="Safe body pull"
                  IsChecked="{Binding SafeBodyPull}"/>

        <TextBlock Grid.Row="22" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Foreground="DarkRed" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"/>

        <StackPanel Grid.Row="23" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add" Padding="14,4" Margin="0,0,8,0" IsDefault="True" Click="OnAddClick"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
