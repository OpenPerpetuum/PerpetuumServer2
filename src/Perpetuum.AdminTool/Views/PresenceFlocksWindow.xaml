<Window x:Class="Perpetuum.AdminTool.Views.PresenceFlocksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Perpetuum.AdminTool.Common"
        Title="Flocks for presence"
        Width="780" Height="460"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F8F8F8" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">
                <TextBlock>
                    <Run FontWeight="Bold" Text="Presence "/>
                    <Run Text="{Binding PresenceId, Mode=OneWay}"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding PresenceName, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Reload" Padding="10,2" Margin="0,0,8,0" Click="OnReloadClick"
                            IsEnabled="{Binding IsLoading, Converter={x:Static common:InverseBoolConverter.Instance}}"/>
                    <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="DimGray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="DarkRed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F8F8F8" Padding="8" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Button Content="Close" Padding="14,4" HorizontalAlignment="Right"
                    IsCancel="True" IsDefault="True" Click="OnCloseClick"/>
        </Border>

        <DataGrid ItemsSource="{Binding Flocks}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Def" Binding="{Binding Definition}" Width="80"/>
                <DataGridTextColumn Header="Definition name" Binding="{Binding DefinitionName}" Width="220"/>
                <DataGridTextColumn Header="Members" Binding="{Binding FlockMemberCount}" Width="80"/>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/>
                <DataGridTextColumn Header="Behavior" Binding="{Binding BehaviorType}" Width="80"/>
                <DataGridTextColumn Header="Special" Binding="{Binding NpcSpecialType}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
