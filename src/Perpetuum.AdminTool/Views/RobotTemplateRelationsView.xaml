<UserControl x:Class="Perpetuum.AdminTool.Views.RobotTemplateRelationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Perpetuum.AdminTool.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <common:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F8F8F8" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="Reload" Padding="10,2" Margin="0,0,8,0" Click="OnReloadClick"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:InverseBoolConverter.Instance}}"/>
                <Button Content="Save changes" Padding="14,2" Margin="0,0,8,0" FontWeight="Bold" Click="OnSaveClick"/>
                <Separator Margin="6,0"/>
                <Button Content="Add relation..." Padding="10,2" Margin="0,0,8,0" Click="OnAddClick"/>
                <Button Content="Remove selected" Padding="10,2" Margin="0,0,8,0" Foreground="DarkRed" Click="OnRemoveClick"/>
                <Separator Margin="6,0"/>
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="180" VerticalAlignment="Center"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="DimGray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="DarkRed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding View}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Definition" IsReadOnly="True"
                                    Binding="{Binding Definition}" Width="90"/>
                <DataGridTemplateColumn Header="Definition name" Width="220" SortMemberPath="DefinitionName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4,0" VerticalAlignment="Center"
                                       Text="{Binding DefinitionName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Source={StaticResource VmProxy}, Path=Data.Lookups.Entities}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Definition"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Display"
                                      SelectedValue="{Binding Definition, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Template id" IsReadOnly="True"
                                    Binding="{Binding TemplateId}" Width="90"/>
                <DataGridTemplateColumn Header="Template name" Width="220" SortMemberPath="TemplateName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4,0" VerticalAlignment="Center"
                                       Text="{Binding TemplateName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Source={StaticResource VmProxy}, Path=Data.Lookups.Templates}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Id"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Display"
                                      SelectedValue="{Binding TemplateId, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Race id"
                                    Binding="{Binding RaceId, UpdateSourceTrigger=LostFocus}" Width="70"/>
                <DataGridTextColumn Header="Item score sum"
                                    Binding="{Binding ItemScoreSum, UpdateSourceTrigger=LostFocus}" Width="100"/>
                <DataGridTextColumn Header="Mission lvl"
                                    Binding="{Binding MissionLevel, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"/>
                <DataGridTextColumn Header="Mission lvl override"
                                    Binding="{Binding MissionLevelOverride, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="120"/>
                <DataGridTextColumn Header="Kill EP"
                                    Binding="{Binding KillEp, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"/>
                <DataGridTextColumn Header="Note"
                                    Binding="{Binding Note, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
