<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perpetuum.AdminTool.Avalonia.ViewModels"
             xmlns:entities="using:Perpetuum.AdminTool.Entities"
             x:Class="Perpetuum.AdminTool.Avalonia.Views.EntityCatalogView"
             x:DataType="vm:EntityCatalogViewModel">
  <Border Padding="16" BorderBrush="#808080" BorderThickness="1" CornerRadius="6">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,280,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Entities" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Browse and queue changes to entitydefaults. Aggregate stats are read-only in this slice."
                     Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox Grid.Column="1" Watermark="definition id or name" Text="{Binding FilterText}" />
        <Button Grid.Column="2" Content="Reload" Command="{Binding LoadCommand}"
                IsEnabled="{Binding IsNotLoading}" />
      </Grid>

      <Grid ColumnDefinitions="340,*" ColumnSpacing="16">
        <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 MinHeight="360" MaxHeight="520">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="entities:EntityDefaultRow">
              <Grid ColumnDefinitions="70,*" ColumnSpacing="8" Margin="2">
                <TextBlock Grid.Column="0" Text="{Binding Definition}" Opacity="0.65" />
                <TextBlock Grid.Column="1" Text="{Binding DefinitionName}"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Spacing="8">
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="10" RowSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Definition" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRow.Definition}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Definition name" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRow.DefinitionName}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Description token" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.DescriptionToken}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Category flags" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRow.CategoryFlags}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Attribute flags" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRow.AttributeFlags}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Mass / volume / health" />
            <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <TextBox Grid.Column="0" Text="{Binding SelectedRow.Mass}" />
              <TextBox Grid.Column="1" Text="{Binding SelectedRow.Volume}" />
              <TextBox Grid.Column="2" Text="{Binding SelectedRow.Health}" />
            </Grid>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Quantity" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedRow.Quantity}" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Availability" />
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <CheckBox Content="Enabled" IsChecked="{Binding SelectedRow.Enabled}" />
              <CheckBox Content="Hidden" IsChecked="{Binding SelectedRow.Hidden}" />
              <CheckBox Content="Purchasable" IsChecked="{Binding SelectedRow.Purchasable}" />
            </StackPanel>
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Options" />
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedRow.Options}" />
          </Grid>

          <TextBlock Text="Aggregate stats" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding SelectedRow.Stats}" MaxHeight="130">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="entities:StatRow">
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding Field}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Revert edits" Command="{Binding RevertSelectedChangesCommand}" />
            <Button Content="Queue changes" Command="{Binding QueueSelectedChangesCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
